# Copy to .env (never commit real values) or set these in your hosting dashboard.

# Persistent storage. Without it the app uses SQLite (./mental_health.db locally,
# ephemeral /tmp storage on Vercel). Any PostgreSQL URL works, e.g. Neon or Supabase:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Extra origins allowed to call the API (comma separated). Not needed for the bundled UI.
# CORS_ORIGINS=https://example.com

# LOG_LEVEL=INFO
# RATE_LIMIT_ENABLED=1
